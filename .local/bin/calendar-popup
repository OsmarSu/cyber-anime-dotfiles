#!/usr/bin/env python3
"""
calendar-popup: Sleek Wayland Layer-Shell calendar popup for Waybar
"""
import os
import sys
import signal
import datetime
import locale

LOCK_FILE = f"/tmp/waybar_calendar_{os.getuid()}.pid"
if os.path.exists(LOCK_FILE):
    try:
        with open(LOCK_FILE, "r") as f:
            pid = int(f.read().strip())
        os.remove(LOCK_FILE)
        os.kill(pid, signal.SIGTERM)
        sys.exit(0)
    except Exception:
        if os.path.exists(LOCK_FILE):
            os.remove(LOCK_FILE)

with open(LOCK_FILE, "w") as f:
    f.write(str(os.getpid()))

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GtkLayerShell, GLib

try:
    locale.setlocale(locale.LC_TIME, "es_ES.UTF-8")
except Exception:
    pass

try:
    import theme_utils
except ImportError:
    sys.path.insert(0, os.path.expanduser("~/.local/bin"))
    import theme_utils

p = theme_utils.get_palette()
CSS = f"""
window {{
    background: transparent;
}}

.calendar-card {{
    background-color: {p['bg']};
    border: 1px solid {p['accent']};
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 22px {p['glow']};
    min-width: 320px;
}}

.clock-text {{
    font-family: 'JetBrainsMono Nerd Font', monospace;
    font-size: 28px;
    font-weight: 800;
    color: {p['accent']};
}}

.date-text {{
    font-family: 'JetBrainsMono Nerd Font', monospace;
    font-size: 13px;
    color: {p['fg_dim']};
    margin-bottom: 4px;
}}

.close-btn {{
    background: transparent;
    color: {p['fg_dim']};
    border: none;
    font-size: 18px;
    padding: 2px 8px;
    border-radius: 6px;
}}
.close-btn:hover {{
    background: {p['glow_alt']};
    color: {p['alt']};
}}

.separator {{
    background-color: {p['surface_border']};
    margin: 6px 0 12px 0;
}}

calendar {{
    background-color: transparent;
    color: {p['fg']};
    border: none;
    font-family: 'JetBrainsMono Nerd Font', monospace;
    font-size: 13px;
}}

calendar:selected {{
    background-color: {p['accent']};
    color: #ffffff;
    border-radius: 6px;
    font-weight: bold;
}}

calendar.header {{
    color: {p['accent']};
    font-weight: bold;
}}

calendar.button {{
    color: {p['accent']};
    background: transparent;
    border: none;
}}

calendar.button:hover {{
    color: {p['alt']};
}}

calendar:indeterminate {{
    color: rgba(143, 168, 184, 0.4);
}}

.close-hint {{
    font-size: 10px;
    color: rgba(143, 168, 184, 0.6);
    margin-top: 8px;
}}
""".encode()

class CalendarPopup(Gtk.Window):
    def __init__(self):
        super().__init__()
        
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 44)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("calendar-card")
        
        # Header Box with Time and Close Button
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        
        time_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        now = datetime.datetime.now()
        self.time_label = Gtk.Label(label=now.strftime("%H:%M:%S"), xalign=0)
        self.time_label.get_style_context().add_class("clock-text")
        time_vbox.pack_start(self.time_label, False, False, 0)
        
        date_str = now.strftime("%A, %d de %B de %Y").capitalize()
        self.date_label = Gtk.Label(label=date_str, xalign=0)
        self.date_label.get_style_context().add_class("date-text")
        time_vbox.pack_start(self.date_label, False, False, 0)
        
        header_box.pack_start(time_vbox, True, True, 0)
        
        close_btn = Gtk.Button(label="󰅖")
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda w: self.destroy())
        header_box.pack_end(close_btn, False, False, 0)
        
        box.pack_start(header_box, False, False, 0)
        
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.get_style_context().add_class("separator")
        box.pack_start(sep, False, False, 0)
        
        # GTK Calendar
        self.calendar = Gtk.Calendar()
        self.calendar.set_property("show-heading", True)
        self.calendar.set_property("show-day-names", True)
        self.calendar.set_property("show-week-numbers", False)
        box.pack_start(self.calendar, True, True, 0)
        
        hint = Gtk.Label(label="Presiona Esc o el botón 󰅖 para cerrar")
        hint.get_style_context().add_class("close-hint")
        box.pack_start(hint, False, False, 0)
        
        self.add(box)
        
        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_destroy)
        
        GLib.timeout_add_seconds(1, self.update_clock)
        
    def update_clock(self):
        now = datetime.datetime.now()
        self.time_label.set_text(now.strftime("%H:%M:%S"))
        return True

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def on_destroy(self, widget):
        if os.path.exists(LOCK_FILE):
            try:
                os.remove(LOCK_FILE)
            except Exception:
                pass
        Gtk.main_quit()

def sigterm_handler(signum, frame):
    if os.path.exists(LOCK_FILE):
        try:
            os.remove(LOCK_FILE)
        except Exception:
            pass
    Gtk.main_quit()

signal.signal(signal.SIGTERM, sigterm_handler)
signal.signal(signal.SIGINT, sigterm_handler)

win = CalendarPopup()
win.show_all()
Gtk.main()
