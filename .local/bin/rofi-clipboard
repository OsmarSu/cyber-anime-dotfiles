#!/usr/bin/env bash
# rofi-clipboard — custom mode rofi che bridge cliphist <-> wl-copy.
#
# Quando rofi lancia uno "script mode", invoca lo script:
#   - SENZA argomenti al primo lancio  → deve stampare la lista delle voci
#   - CON argomento (la riga scelta)   → deve eseguire l'azione, output ignorato
#
# Variabili rofi disponibili:
#   ROFI_RETV=0  → primo lancio (lista)
#   ROFI_RETV=1  → utente ha selezionato una voce
#
# Riferimento: man rofi-script

export PATH="$HOME/.local/bin:$PATH"

if [[ -z "${1:-}" ]]; then
    # Primo lancio: ritorna lista cliphist (id<TAB>preview)
    output=$(cliphist list 2>/dev/null || true)
    if [[ -z "$output" ]]; then
        echo "󰅇  (Portapapeles vacío)"
    else
        printf '%s\n' "$output"
    fi
else
    # Voce selezionata: decodifica e copia in clipboard Wayland
    if [[ "$1" != *"Portapapeles vacío"* ]]; then
        printf '%s' "$1" | cliphist decode 2>/dev/null | wl-copy 2>/dev/null || true
    fi
fi
