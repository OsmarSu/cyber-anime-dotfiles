#!/usr/bin/env python3
"""
battery-control: Universal Battery & Power Profile Manager for Cyber-Anime Dotfiles.
Supports:
  - Lenovo Legion / IdeaPad (conservation_mode: ~60% limit)
  - ASUS, ThinkPad, Framework, Huawei (standard charge_control_end_threshold: 60/80/100%)
  - LG Gram (battery_care_limit: 80%)
  - Samsung (battery_life_extender: 80%)
  - Universal Power Profiles (powerprofilesctl)
  - Interactive Cyber-Anime Rofi Menu
"""

import os
import sys
import glob
import subprocess
import argparse
import json
import shutil

ROFI_THEME = os.path.expanduser("~/.config/rofi/dialog.rasi")
UDEV_RULE_PATH = "/etc/udev/rules.d/99-battery-charge-control.rules"

def run_cmd(cmd_list, capture=True):
    try:
        res = subprocess.run(cmd_list, capture_output=capture, text=True, check=False)
        return res.stdout.strip() if capture else ""
    except Exception:
        return ""

def notify(title, message, icon="battery", urgency="normal"):
    cmd = ["notify-send", "-a", "Gestor de Energía", "-u", urgency]
    if icon:
        cmd += ["-i", icon]
    cmd += [title, message]
    subprocess.run(cmd, check=False)

def is_real_terminal():
    try:
        if not sys.stdin.isatty():
            return False
        if os.getpgrp() != os.tcgetpgrp(sys.stdin.fileno()):
            return False
        tname = os.ttyname(sys.stdin.fileno())
        # Only accept pseudo-terminals (/dev/pts/*), not Linux virtual consoles (/dev/tty1)
        return tname.startswith("/dev/pts")
    except Exception:
        return False

class BatteryManager:
    def __init__(self):
        self.bat_path = None
        self.mode_type = None  # "lenovo", "threshold", "lg", "samsung", None
        self.control_path = None
        self._detect()

    def _detect(self):
        # 1. Find battery directory
        bats = glob.glob("/sys/class/power_supply/BAT*")
        if bats:
            self.bat_path = sorted(bats)[0]

        # 2. Check Lenovo Legion / IdeaPad conservation mode
        lenovo_paths = (
            glob.glob("/sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode") +
            glob.glob("/sys/devices/platform/ideapad_acpi/conservation_mode")
        )
        for p in lenovo_paths:
            if os.path.exists(p):
                self.mode_type = "lenovo"
                self.control_path = p
                return

        # 3. Check Standard charge_control_end_threshold (ASUS, ThinkPad, Framework, etc.)
        thresh_paths = glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold")
        for p in thresh_paths:
            if os.path.exists(p):
                self.mode_type = "threshold"
                self.control_path = p
                return

        # 4. Check LG Gram
        lg_path = "/sys/devices/platform/lg-laptop/battery_care_limit"
        if os.path.exists(lg_path):
            self.mode_type = "lg"
            self.control_path = lg_path
            return

        # 5. Check Samsung
        samsung_path = "/sys/devices/platform/samsung-laptop/battery_life_extender"
        if os.path.exists(samsung_path):
            self.mode_type = "samsung"
            self.control_path = samsung_path
            return

    def get_info(self):
        info = {
            "has_battery": self.bat_path is not None,
            "mode_type": self.mode_type,
            "control_path": self.control_path,
            "capacity": 0,
            "status": "Unknown",
            "health": 100.0,
            "cycles": None,
            "power_w": 0.0,
            "conservation_active": False,
            "charge_limit": 100,
            "power_profile": self.get_power_profile(),
        }

        if not self.bat_path:
            return info

        # Read basic battery stats
        try:
            with open(os.path.join(self.bat_path, "capacity"), "r") as f:
                info["capacity"] = int(f.read().strip())
        except Exception:
            pass

        try:
            with open(os.path.join(self.bat_path, "status"), "r") as f:
                info["status"] = f.read().strip()
        except Exception:
            pass

        try:
            with open(os.path.join(self.bat_path, "cycle_count"), "r") as f:
                info["cycles"] = int(f.read().strip())
        except Exception:
            pass

        # Calculate battery health
        try:
            en_full = None
            en_design = None
            for prefix in ["energy", "charge"]:
                f_full = os.path.join(self.bat_path, f"{prefix}_full")
                f_design = os.path.join(self.bat_path, f"{prefix}_full_design")
                if os.path.exists(f_full) and os.path.exists(f_design):
                    with open(f_full) as f:
                        en_full = float(f.read().strip())
                    with open(f_design) as f:
                        en_design = float(f.read().strip())
                    break
            if en_full and en_design and en_design > 0:
                info["health"] = round((en_full / en_design) * 100, 1)
        except Exception:
            pass

        # Read instantaneous power consumption
        try:
            f_pwr = os.path.join(self.bat_path, "power_now")
            if os.path.exists(f_pwr):
                with open(f_pwr) as f:
                    uwatts = float(f.read().strip())
                    info["power_w"] = round(uwatts / 1_000_000.0, 1)
        except Exception:
            pass

        # Read Conservation / Threshold state
        if self.mode_type == "lenovo" and self.control_path:
            try:
                with open(self.control_path, "r") as f:
                    val = f.read().strip()
                    info["conservation_active"] = (val == "1")
                    info["charge_limit"] = 60 if info["conservation_active"] else 100
            except Exception:
                pass
        elif self.mode_type == "threshold" and self.control_path:
            try:
                with open(self.control_path, "r") as f:
                    val = int(f.read().strip())
                    info["charge_limit"] = val
                    info["conservation_active"] = (val < 100)
            except Exception:
                pass
        elif self.mode_type == "lg" and self.control_path:
            try:
                with open(self.control_path, "r") as f:
                    val = int(f.read().strip())
                    info["charge_limit"] = val
                    info["conservation_active"] = (val == 80)
            except Exception:
                pass
        elif self.mode_type == "samsung" and self.control_path:
            try:
                with open(self.control_path, "r") as f:
                    val = f.read().strip()
                    info["conservation_active"] = (val == "1")
                    info["charge_limit"] = 80 if info["conservation_active"] else 100
            except Exception:
                pass

        return info

    def get_power_profile(self):
        if shutil.which("powerprofilesctl"):
            prof = run_cmd(["powerprofilesctl", "get"])
            return prof if prof else "balanced"
        return "unknown"

    def set_power_profile(self, profile):
        if profile not in ["performance", "balanced", "power-saver"]:
            return False
        if not shutil.which("powerprofilesctl"):
            notify("Error de Energía", "power-profiles-daemon no está disponible.", icon="dialog-error")
            return False

        res = subprocess.run(["powerprofilesctl", "set", profile], check=False)
        profile_names = {
            "performance": "󰓅 Rendimiento Máximo",
            "balanced": "󰾆 Equilibrado",
            "power-saver": "󰾆 Ahorro de Batería"
        }
        name = profile_names.get(profile, profile)
        notify("Perfil de Energía", f"Perfil cambiado a: {name}", icon="system-run")
        return res.returncode == 0

    def _write_sysfs(self, value):
        if not self.control_path:
            return False

        str_val = str(value)
        # Try direct write first (fast path when udev rule is active)
        try:
            with open(self.control_path, "w") as f:
                f.write(f"{str_val}\n")
            return True
        except PermissionError:
            pass
        except Exception as e:
            notify("Error", f"No se pudo escribir en sysfs: {e}", icon="dialog-error")
            return False

        # If direct write failed due to permissions, prompt the user gracefully
        # If in a real interactive terminal window (/dev/pts/*), we can use sudo directly
        if is_real_terminal():
            cmd = ["sudo", "sh", "-c", f"echo '{str_val}' > '{self.control_path}'"]
            try:
                res = subprocess.run(cmd, check=False, timeout=20)
                return res.returncode == 0
            except Exception:
                return False

        # If in GUI (Waybar, Rofi, Cyber Settings), NEVER run raw sudo!
        # Launch floating kitty terminal with DEVNULL to avoid SIGTTIN freeze
        notify("Permiso Requerido", "Abre la ventana emergente para habilitar el control sin contraseña...", icon="security-medium")
        cmd_str = (
            "echo -e '\\033[1;36m=== Gestor de Batería: Configuración de Permisos ===\\033[0m\\n'; "
            "echo 'Se requiere tu contraseña una sola vez para habilitar el control'; "
            "echo 'de batería permanente sin contraseña (regla udev).'; echo ''; "
            f"sudo {sys.executable} {os.path.expanduser('~/.local/bin/battery-control')} install-rules-direct && "
            f"echo '{str_val}' | sudo tee '{self.control_path}' > /dev/null && "
            "echo -e '\\n\\033[1;32m✓ ¡Permisos configurados con éxito!\\033[0m'; "
            "sleep 1.5"
        )
        try:
            subprocess.run(["kitty", "--class", "floating-tool", "-e", "bash", "-c", cmd_str],
                           stdin=subprocess.DEVNULL, check=False)
            try:
                with open(self.control_path, "r") as f:
                    return f.read().strip() == str_val
            except Exception:
                return False
        except Exception:
            return False

    def set_conservation(self, enable: bool, threshold: int = 80):
        if not self.mode_type:
            notify("Aviso", "Este equipo no dispone de soporte para límite de carga en el kernel.", icon="dialog-warning")
            return False

        success = False
        limit_desc = ""

        if self.mode_type == "lenovo":
            success = self._write_sysfs("1" if enable else "0")
            limit_desc = "60% (Lenovo Legion)"
        elif self.mode_type == "threshold":
            target = threshold if enable else 100
            success = self._write_sysfs(target)
            limit_desc = f"{target}%"
        elif self.mode_type == "lg":
            target = 80 if enable else 100
            success = self._write_sysfs(target)
            limit_desc = f"{target}% (LG Gram Care)"
        elif self.mode_type == "samsung":
            success = self._write_sysfs("1" if enable else "0")
            limit_desc = "80% (Samsung Extender)"

        if success:
            if enable:
                notify(
                    "🛡️ Modo Conservación Activado",
                    f"Carga limitada al {limit_desc}.\nProtege la vida útil de la batería conectado a AC.",
                    icon="battery-charging"
                )
            else:
                notify(
                    "󰁹 Modo Conservación Desactivado",
                    "Carga completa autorizada hasta el 100%.",
                    icon="battery-full-charged"
                )
        return success

    def toggle_conservation(self):
        info = self.get_info()
        if not self.mode_type:
            notify("Modo Conservación", "Este equipo no soporta regulación de carga por hardware.", icon="dialog-information")
            return False
        return self.set_conservation(not info["conservation_active"])

    def open_rofi_menu(self):
        info = self.get_info()
        
        # Build header information message
        cap = info["capacity"]
        status = info["status"]
        health = info["health"]
        cycles = f"{info['cycles']} ciclos" if info["cycles"] is not None else ""
        power_str = f" • {info['power_w']}W" if info["power_w"] > 0 else ""
        prof = info["power_profile"]

        if info["mode_type"] == "lenovo":
            brand_label = "Lenovo Legion / IdeaPad"
        elif info["mode_type"] == "threshold":
            brand_label = "ASUS / ThinkPad / Framework"
        elif info["mode_type"] == "lg":
            brand_label = "LG Gram"
        elif info["mode_type"] == "samsung":
            brand_label = "Samsung"
        else:
            brand_label = "Genérico / Universal"

        msg = (
            f"Batería: {cap}% ({status}){power_str}  |  Salud: {health}% {cycles}\n"
            f"Hardware: {brand_label}  |  Perfil actual: {prof}"
        )

        menu_items = []

        # 1. Conservation Mode toggle
        if self.mode_type:
            if info["conservation_active"]:
                menu_items.append(f"🛡️  Modo Conservación: ACTIVO (Límite {info['charge_limit']}%)  ->  Desactivar (Cargar al 100%)")
            else:
                menu_items.append(f"󰁹  Modo Conservación: DESACTIVADO (100%)  ->  Activar (Límite {60 if self.mode_type == 'lenovo' else 80}%)")

            # If flexible threshold (ASUS / ThinkPad / Framework)
            if self.mode_type == "threshold":
                menu_items.append("⚙️   Fijar Límite en 60% (Máxima protección)")
                menu_items.append("⚙️   Fijar Límite en 80% (Recomendado día a día)")
                menu_items.append("⚙️   Fijar Límite en 100% (Carga total)")

        # 2. Power Profiles
        menu_items.append("󰓅  Perfil: Rendimiento Máximo (Performance)" + ("  ✓" if prof == "performance" else ""))
        menu_items.append("󰾆  Perfil: Equilibrado (Balanced)" + ("  ✓" if prof == "balanced" else ""))
        menu_items.append("󰾆  Perfil: Ahorro de Batería (Power Saver)" + ("  ✓" if prof == "power-saver" else ""))

        # 3. Extras
        menu_items.append("󰻠  Abrir Monitor de Batería y Recursos (Btop)")
        menu_items.append("󰒓  Abrir Panel de Ajustes Cyber (Super + S)")
        menu_items.append("󰅖  Cerrar menú")

        # Run Rofi
        cmd = ["rofi", "-dmenu", "-i", "-p", "󰂄 Batería y Energía", "-mesg", msg]
        if os.path.isfile(ROFI_THEME):
            cmd += ["-theme", ROFI_THEME]
        else:
            cmd += ["-theme-str", "window { width: 720px; border-radius: 16px; } listview { lines: 8; }"]

        res = subprocess.run(cmd, input="\n".join(menu_items), text=True, capture_output=True)
        chosen = res.stdout.strip()

        if not chosen or "Cerrar" in chosen:
            return

        if "Modo Conservación:" in chosen:
            self.toggle_conservation()
        elif "Fijar Límite en 60%" in chosen:
            self.set_conservation(True, threshold=60)
        elif "Fijar Límite en 80%" in chosen:
            self.set_conservation(True, threshold=80)
        elif "Fijar Límite en 100%" in chosen:
            self.set_conservation(False, threshold=100)
        elif "Rendimiento Máximo" in chosen:
            self.set_power_profile("performance")
        elif "Equilibrado" in chosen:
            self.set_power_profile("balanced")
        elif "Ahorro de Batería" in chosen:
            self.set_power_profile("power-saver")
        elif "Btop" in chosen:
            subprocess.Popen(["kitty", "--class", "floating-tool", "-e", "btop"])
        elif "Ajustes Cyber" in chosen:
            subprocess.Popen([os.path.expanduser("~/.local/bin/cyber-settings")])

    def generate_udev_rule(self):
        return """# Permisos de usuario para control de carga y batería en Linux
# Compatible con Lenovo Legion/IdeaPad, ASUS ROG/TUF, ThinkPad, Framework, LG Gram y Samsung.

# Lenovo Legion e IdeaPad (conservation_mode)
SUBSYSTEM=="platform", DRIVERS=="ideapad_acpi", ATTR{conservation_mode}="[01]", RUN+="/bin/chmod 0666 /sys%p/conservation_mode"
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="VPC2004:00", RUN+="/bin/chmod 0666 /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode"

# Umbral estándar de carga de baterías (ASUS, ThinkPad, Framework, Huawei, etc.)
SUBSYSTEM=="power_supply", ATTR{charge_control_end_threshold}="*", RUN+="/bin/chmod 0666 /sys%p/charge_control_end_threshold"
SUBSYSTEM=="power_supply", ATTR{charge_control_start_threshold}="*", RUN+="/bin/chmod 0666 /sys%p/charge_control_start_threshold"

# LG Gram y Samsung
SUBSYSTEM=="platform", ATTR{battery_care_limit}="*", RUN+="/bin/chmod 0666 /sys%p/battery_care_limit"
SUBSYSTEM=="platform", ATTR{battery_life_extender}="*", RUN+="/bin/chmod 0666 /sys%p/battery_life_extender"
"""

    def install_udev_rule_direct(self):
        if os.geteuid() != 0:
            print("Error: Este comando debe ejecutarse como root (con sudo).")
            return False
        rules_content = self.generate_udev_rule()
        with open(UDEV_RULE_PATH, "w") as f:
            f.write(rules_content)
        os.chmod(UDEV_RULE_PATH, 0o644)
        subprocess.run(["udevadm", "control", "--reload-rules"], check=False)
        subprocess.run(["udevadm", "trigger"], check=False)
        if self.control_path and os.path.exists(self.control_path):
            os.chmod(self.control_path, 0o666)
        notify("Permisos Udev Configurados", "El control de batería ahora funciona sin contraseña.", icon="security-high")
        print("[+] Regla udev instalada y permisos aplicados con éxito.")
        return True

    def install_udev_rule(self):
        if os.geteuid() == 0:
            return self.install_udev_rule_direct()

        if is_real_terminal():
            cmd = ["sudo", sys.executable, os.path.expanduser("~/.local/bin/battery-control"), "install-rules-direct"]
            res = subprocess.run(cmd, check=False)
            return res.returncode == 0
        else:
            cmd_str = (
                "echo -e '\\033[1;36m=== Configurar Permisos de Batería (Udev) ===\\033[0m\\n'; "
                "echo 'Ingresa tu contraseña para instalar la regla udev permanente:'; echo ''; "
                f"sudo {sys.executable} {os.path.expanduser('~/.local/bin/battery-control')} install-rules-direct; "
                "echo ''; read -n 1 -s -r -p 'Presiona cualquier tecla para continuar...'"
            )
            res = subprocess.run(["kitty", "--class", "floating-tool", "-e", "bash", "-c", cmd_str],
                                 stdin=subprocess.DEVNULL, check=False)
            return res.returncode == 0

def main():
    parser = argparse.ArgumentParser(description="Universal Battery & Power Manager")
    parser.add_argument("action", nargs="?", default="status",
                        choices=["status", "toggle", "set", "profile", "menu", "setup-udev", "install-rules-direct", "print-udev"],
                        help="Action to perform")
    parser.add_argument("value", nargs="?", default=None, help="Value for set or profile")
    parser.add_argument("--json", action="store_true", help="Output status in JSON format")

    args = parser.parse_args()
    mgr = BatteryManager()

    if args.action == "install-rules-direct":
        mgr.install_udev_rule_direct()

    if args.action == "status":
        info = mgr.get_info()
        if args.json:
            print(json.dumps(info, indent=2))
        else:
            print(f"Batería presente: {info['has_battery']}")
            print(f"Capacidad: {info['capacity']}% ({info['status']})")
            print(f"Salud: {info['health']}%")
            if info['cycles'] is not None:
                print(f"Ciclos: {info['cycles']}")
            print(f"Consumo: {info['power_w']} W")
            print(f"Hardware detectado: {info['mode_type']} ({info['control_path']})")
            print(f"Modo Conservación activo: {info['conservation_active']} (Límite: {info['charge_limit']}%)")
            print(f"Perfil de energía: {info['power_profile']}")

    elif args.action == "toggle":
        mgr.toggle_conservation()

    elif args.action == "set":
        val = (args.value or "").lower()
        if val in ["on", "1", "true"]:
            mgr.set_conservation(True)
        elif val in ["off", "0", "false"]:
            mgr.set_conservation(False)
        elif val.isdigit():
            mgr.set_conservation(True, threshold=int(val))
        else:
            print("Uso: battery-control set [on|off|60|80|100]")

    elif args.action == "profile":
        if args.value:
            mgr.set_power_profile(args.value)
        else:
            print("Uso: battery-control profile [performance|balanced|power-saver]")

    elif args.action == "menu":
        mgr.open_rofi_menu()

    elif args.action == "setup-udev":
        mgr.install_udev_rule()

    elif args.action == "print-udev":
        print(mgr.generate_udev_rule())

if __name__ == "__main__":
    main()
