CUSTOM_KEYBINDS_JSON = os.path.expanduser("~/.config/hypr/custom_keybinds.json")
CUSTOM_KEYBINDS_LUA = os.path.expanduser("~/.config/hypr/conf/custom_keybinds.lua")

def load_custom_keybinds():
    if os.path.isfile(CUSTOM_KEYBINDS_JSON):
        try:
            with open(CUSTOM_KEYBINDS_JSON, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return []

def save_custom_keybinds(keybinds):
    try:
        with open(CUSTOM_KEYBINDS_JSON, "w", encoding="utf-8") as f:
            json.dump(keybinds, f, indent=2, ensure_ascii=False)
        generate_custom_lua(keybinds)
        spawn_cmd("hyprctl reload")
    except Exception as e:
        print(f"Error saving custom keybinds: {e}", file=sys.stderr)

def generate_custom_lua(keybinds):
    lines = [
        "-- conf/custom_keybinds.lua",
        "-- Atajos personalizados gestionados automáticamente por Cyber Settings.",
        "local hl = hl or {}",
        "local home = os.getenv(\"HOME\")",
        ""
    ]
    for kb in keybinds:
        keys = kb.get("keys", "").strip()
        cmd = kb.get("cmd", "").strip()
        if keys and cmd:
            esc_cmd = cmd.replace('\\', '\\\\').replace('"', '\\"')
            esc_keys = keys.replace('\\', '\\\\').replace('"', '\\"')
            lines.append(f'hl.bind("{esc_keys}", hl.dsp.exec_cmd("{esc_cmd}"))')

    try:
        with open(CUSTOM_KEYBINDS_LUA, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except Exception as e:
        print(f"Error writing custom_keybinds.lua: {e}", file=sys.stderr)


def run_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True).decode().strip()
    except Exception:
        return ""

def spawn_cmd(cmd):
    try:
        subprocess.Popen(cmd, shell=True)
    except Exception:
        pass

class CyberSettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__()

        # Setup Layer-Shell
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        # Center window by leaving all edge anchors false
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        GtkLayerShell.set_namespace(self, "cyber-settings")

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        main_box.get_style_context().add_class("main-panel")

        # Top Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("header-bar")

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(label="󱗼 CYBER CONTROL CENTER", xalign=0)
        title_lbl.get_style_context().add_class("panel-title")
        sub_lbl = Gtk.Label(label="Configuración de Sistema · Estética Neon & Hacker · Hyprland", xalign=0)
        sub_lbl.get_style_context().add_class("panel-sub")
        title_box.pack_start(title_lbl, False, False, 0)
        title_box.pack_start(sub_lbl, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        # Quick stats badge
        stats_lbl = Gtk.Label(label=self.get_quick_stats(), xalign=1)
        stats_lbl.get_style_context().add_class("panel-sub")
        header.pack_start(stats_lbl, False, False, 10)

        close_btn = Gtk.Button(label="󰅖")
        close_btn.get_style_context().add_class("close-btn")
        close_btn.connect("clicked", lambda w: self.close_window())
        header.pack_end(close_btn, False, False, 0)

        main_box.pack_start(header, False, False, 0)

        # Body: Sidebar + Stack
        body_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)

        # Sidebar
        self.sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.sidebar.get_style_context().add_class("sidebar")

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)

        # Pages
        self.nav_buttons = []
        self.add_page("appearance", "󰄛 Apariencia", self.build_appearance_page())
        self.add_page("system", "⚡ Rendimiento", self.build_system_page())
        self.add_page("audio", "󰕾 Audio & Red", self.build_audio_page())
        self.add_page("keybinds", "⌨ Atajos (<)", self.build_keybinds_page())
        self.add_page("tools", "🛠 Herramientas", self.build_tools_page())

        body_box.pack_start(self.sidebar, False, False, 0)
        body_box.pack_start(self.stack, True, True, 0)
        main_box.pack_start(body_box, True, True, 0)

        self.add(main_box)
        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_destroy)

    def get_quick_stats(self):
        try:
            uptime = run_cmd("uptime -p | sed 's/up //'")
            return f"󰔟 {uptime}"
        except Exception:
            return ""

    def add_page(self, name, label, widget):
        btn = Gtk.Button(label=label)
        btn.get_style_context().add_class("nav-btn")
        if btn.get_child():
            btn.get_child().set_halign(Gtk.Align.START)
        btn.connect("clicked", lambda w: self.switch_page(name, btn))
        self.sidebar.pack_start(btn, False, False, 0)
        self.nav_buttons.append((name, btn))
        self.stack.add_named(widget, name)

        if len(self.nav_buttons) == 1:
            btn.get_style_context().add_class("active")
            self.stack.set_visible_child_name(name)

    def switch_page(self, name, clicked_btn):
        for n, btn in self.nav_buttons:
            if n == name:
                btn.get_style_context().add_class("active")
            else:
                btn.get_style_context().remove_class("active")
        self.stack.set_visible_child_name(name)

    # ────────────────────────── PAGES ──────────────────────────
    def build_appearance_page(self):
