        sw_anim = Gtk.Switch()
        sw_anim.set_active(True)
        sw_anim.connect("notify::active", lambda s, p: spawn_cmd(f"hyprctl keyword animations:enabled {'1' if s.get_active() else '0'}"))
        row_anim.pack_start(lbl_anim, True, True, 0)
        row_anim.pack_end(sw_anim, False, False, 0)
        c3.pack_start(row_anim, False, False, 0)

