    def build_system_page(self):
        scroll = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.get_style_context().add_class("content-page")

        # 1. Perfiles de Energía
        c1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        c1.get_style_context().add_class("card")
        c1_title = Gtk.Label(label="⚡ Perfil de Energía y Rendimiento", xalign=0)
        c1_title.get_style_context().add_class("card-title")
        c1_desc = Gtk.Label(label="Ajusta los estados de energía de la CPU y GPU según la carga de trabajo.", xalign=0)
        c1_desc.get_style_context().add_class("card-desc")
        c1.pack_start(c1_title, False, False, 0)
        c1.pack_start(c1_desc, False, False, 0)

        pwr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        b_perf = Gtk.Button(label="󰓅 Rendimiento Máximo")
        b_perf.get_style_context().add_class("cyber-btn")
        b_perf.connect("clicked", lambda w: spawn_cmd("powerprofilesctl set performance && notify-send 'Energía' 'Perfil: Rendimiento' -i system-run"))

        b_bal = Gtk.Button(label="󰾆 Equilibrado")
        b_bal.get_style_context().add_class("cyber-btn")
        b_bal.connect("clicked", lambda w: spawn_cmd("powerprofilesctl set balanced && notify-send 'Energía' 'Perfil: Equilibrado' -i system-run"))

        b_save = Gtk.Button(label="󰾆 Ahorro de Batería")
        b_save.get_style_context().add_class("cyber-btn")
        b_save.connect("clicked", lambda w: spawn_cmd("powerprofilesctl set power-saver && notify-send 'Energía' 'Perfil: Ahorro' -i system-run"))

        pwr_box.pack_start(b_perf, True, True, 0)
        pwr_box.pack_start(b_bal, True, True, 0)
        pwr_box.pack_start(b_save, True, True, 0)
        c1.pack_start(pwr_box, False, False, 6)
        box.pack_start(c1, False, False, 0)

        # 2. Control de Reposo
        c2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        c2.get_style_context().add_class("card")
        c2_title = Gtk.Label(label="󰒲 Modo de Reposo y Pantalla", xalign=0)
        c2_title.get_style_context().add_class("card-title")

        row_idle = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_idle = Gtk.Label(label="Inhibir reposo automático (Mantener sistema y pantalla despiertos)", xalign=0)
        lbl_idle.get_style_context().add_class("card-desc")
        sw_idle = Gtk.Switch()
        sw_idle.set_active(run_cmd("pgrep -x hypridle") == "")
        sw_idle.connect("notify::active", lambda s, p: spawn_cmd("~/.config/waybar/scripts/idle-toggle.sh"))
        row_idle.pack_start(lbl_idle, True, True, 0)
        row_idle.pack_end(sw_idle, False, False, 0)
        c2.pack_start(c2_title, False, False, 0)
        c2.pack_start(row_idle, False, False, 0)
        box.pack_start(c2, False, False, 0)

        # 3. Especificaciones del Hardware
        c3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        c3.get_style_context().add_class("card")
        c3_title = Gtk.Label(label="󰍹 Diagnóstico y Especificaciones", xalign=0)
        c3_title.get_style_context().add_class("card-title")
        c3.pack_start(c3_title, False, False, 0)

        cpu_name = run_cmd("lscpu | grep 'Model name' | head -n1 | cut -d: -f2 | xargs")
        os_info = run_cmd('uname -s -r')
        host_info = run_cmd('cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || hostname')
        info_text = (
            f"OS: {os_info}\n"
            f"Host: {host_info}\n"
            f"CPU: {cpu_name}\n"
            f"Hyprland: v0.55+ (Wayland Native Compositor)"
        )
        info_lbl = Gtk.Label(label=info_text, xalign=0)
        info_lbl.get_style_context().add_class("card-desc")
        c3.pack_start(info_lbl, False, False, 0)

        btop_btn = Gtk.Button(label="󰻠 Abrir Monitor de Procesos (Btop)")
        btop_btn.get_style_context().add_class("cyber-btn")
        btop_btn.connect("clicked", lambda w: (spawn_cmd("kitty --class floating-tool -e btop"), self.close_window()))
        c3.pack_start(btop_btn, False, False, 6)
        box.pack_start(c3, False, False, 0)

        scroll.add(box)
        return scroll

    def build_audio_page(self):
        scroll = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.get_style_context().add_class("content-page")

        # 1. Salida de Audio (Sink)
        c1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        c1.get_style_context().add_class("card")
        c1_title = Gtk.Label(label="󰕾 Control de Salida (Altavoces / Auriculares)", xalign=0)
        c1_title.get_style_context().add_class("card-title")
        c1.pack_start(c1_title, False, False, 0)

        sink_vol_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        sink_mute_btn = Gtk.Button(label="󰕾 Mute")
        sink_mute_btn.get_style_context().add_class("cyber-btn")
        sink_mute_btn.connect("clicked", lambda w: spawn_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"))

        sink_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        try:
            vol_out = run_cmd("wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'")
            sink_scale.set_value(float(vol_out or 50))
        except Exception:
            sink_scale.set_value(50)
        sink_scale.connect("value-changed", lambda s: spawn_cmd(f"wpctl set-volume @DEFAULT_AUDIO_SINK@ {int(s.get_value())}%"))

        sink_vol_box.pack_start(sink_mute_btn, False, False, 0)
        sink_vol_box.pack_start(sink_scale, True, True, 0)
        c1.pack_start(sink_vol_box, False, False, 0)

        pavu_btn = Gtk.Button(label="󰝚 Abrir Panel de Volumen Avanzado (Popup)")
        pavu_btn.get_style_context().add_class("cyber-btn")
        pavu_btn.connect("clicked", lambda w: (spawn_cmd("~/.local/bin/volume-popup"), self.close_window()))
        c1.pack_start(pavu_btn, False, False, 4)
        box.pack_start(c1, False, False, 0)

        # 2. Entrada de Audio (Mic)
        c2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        c2.get_style_context().add_class("card")
        c2_title = Gtk.Label(label="󰍬 Control de Entrada (Micrófono)", xalign=0)
        c2_title.get_style_context().add_class("card-title")
        c2.pack_start(c2_title, False, False, 0)

        mic_vol_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        mic_mute_btn = Gtk.Button(label="󰍬 Mute")
        mic_mute_btn.get_style_context().add_class("cyber-btn")
        mic_mute_btn.connect("clicked", lambda w: spawn_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"))

        mic_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        try:
            vol_m = run_cmd("wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print int($2 * 100)}'")
            mic_scale.set_value(float(vol_m or 50))
        except Exception:
            mic_scale.set_value(50)
        mic_scale.connect("value-changed", lambda s: spawn_cmd(f"wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {int(s.get_value())}%"))

        mic_vol_box.pack_start(mic_mute_btn, False, False, 0)
        mic_vol_box.pack_start(mic_scale, True, True, 0)
        c2.pack_start(mic_vol_box, False, False, 0)
        box.pack_start(c2, False, False, 0)

        # 3. Conexiones (Red y Bluetooth)
        c3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        c3.get_style_context().add_class("card")
        c3_title = Gtk.Label(label="󰤨 Red y Conectividad Inalámbrica", xalign=0)
        c3_title.get_style_context().add_class("card-title")
        c3.pack_start(c3_title, False, False, 0)

        net_btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        b_wifi = Gtk.Button(label="󰤨 Gestor Wi-Fi (nmtui)")
        b_wifi.get_style_context().add_class("cyber-btn")
        b_wifi.connect("clicked", lambda w: (spawn_cmd("kitty --class floating-tool -e nmtui"), self.close_window()))

        b_bt = Gtk.Button(label="󰂯 Dispositivos Bluetooth")
        b_bt.get_style_context().add_class("cyber-btn")
        b_bt.connect("clicked", lambda w: (spawn_cmd("~/.local/bin/rofi-bluetooth"), self.close_window()))

        net_btns.pack_start(b_wifi, True, True, 0)
        net_btns.pack_start(b_bt, True, True, 0)
        c3.pack_start(net_btns, False, False, 4)
        box.pack_start(c3, False, False, 0)

        scroll.add(box)
        return scroll

    def delete_custom_keybind(self, kb_id, keys):
        custom_list = load_custom_keybinds()
        custom_list = [item for item in custom_list if item.get("id") != kb_id]
        save_custom_keybinds(custom_list)
        spawn_cmd(f"notify-send -a 'Cyber Control' '󰅖 Atajo eliminado' '{keys}'")

    def build_keybinds_page(self):
        page_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_box.get_style_context().add_class("content-page")

        # Top control bar: Search bar + Add Shortcut button
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        search_entry = Gtk.SearchEntry()
        search_entry.set_placeholder_text("󰍉 Filtrar atajos de teclado (escribe para buscar)...")
        search_entry.get_style_context().add_class("search-entry")
        top_bar.pack_start(search_entry, True, True, 0)

        btn_add = Gtk.Button(label="󰐕 Agregar Atajo")
        btn_add.get_style_context().add_class("cyber-btn")
        top_bar.pack_start(btn_add, False, False, 0)

        page_box.pack_start(top_bar, False, False, 0)

        # Collapsible Card to Add New Shortcut
        revealer = Gtk.Revealer()
        revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        revealer.set_transition_duration(250)

        add_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        add_card.get_style_context().add_class("card")

        form_title = Gtk.Label(label="󰐕 CONFIGURAR NUEVO ATAJO DE TECLADO", xalign=0)
        form_title.get_style_context().add_class("card-title")
        add_card.pack_start(form_title, False, False, 0)

        # Form Fields Grid
        grid = Gtk.Grid()
        grid.set_column_spacing(16)
        grid.set_row_spacing(10)

        # Field 1: Combinación de Teclas + Modifier chips
        keys_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_keys = Gtk.Label(label="Combinación de teclas (ej: SUPER + M, SUPER + SHIFT + X):", xalign=0)
        lbl_keys.get_style_context().add_class("form-label")
        entry_keys = Gtk.Entry()
        entry_keys.set_placeholder_text("SUPER + ")
        entry_keys.get_style_context().add_class("search-entry")

        chips_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        for mod in ["SUPER + ", "SHIFT + ", "CTRL + ", "ALT + "]:
            chip = Gtk.Button(label=f"+{mod.strip()}")
            chip.get_style_context().add_class("chip-btn")
            def on_chip(btn, m=mod):
                cur = entry_keys.get_text().strip()
                if not cur:
                    entry_keys.set_text(m)
                elif m not in cur:
                    entry_keys.set_text(m + cur)
                entry_keys.grab_focus()
                entry_keys.set_position(-1)
            chip.connect("clicked", on_chip)
            chips_box.pack_start(chip, False, False, 0)

        keys_box.pack_start(lbl_keys, False, False, 0)
        keys_box.pack_start(entry_keys, False, False, 0)
        keys_box.pack_start(chips_box, False, False, 0)
        grid.attach(keys_box, 0, 0, 1, 1)

        # Field 2: Descripción
        desc_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_desc = Gtk.Label(label="Nombre o Descripción del atajo:", xalign=0)
        lbl_desc.get_style_context().add_class("form-label")
        entry_desc = Gtk.Entry()
        entry_desc.set_placeholder_text("Ej: Abrir Spotify, Editor de Notas...")
        entry_desc.get_style_context().add_class("search-entry")
        desc_box.pack_start(lbl_desc, False, False, 0)
        desc_box.pack_start(entry_desc, False, False, 0)
        grid.attach(desc_box, 1, 0, 1, 1)

        # Field 3: Comando a ejecutar
        cmd_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_cmd = Gtk.Label(label="Comando a ejecutar en el sistema:", xalign=0)
        lbl_cmd.get_style_context().add_class("form-label")
        entry_cmd = Gtk.Entry()
        entry_cmd.set_placeholder_text("Ej: spotify, obsidian, kitty -e btop, pavucontrol...")
        entry_cmd.get_style_context().add_class("search-entry")
        cmd_box.pack_start(lbl_cmd, False, False, 0)
        cmd_box.pack_start(entry_cmd, False, False, 0)
        grid.attach(cmd_box, 0, 1, 1, 1)

        # Field 4: Categoría
        cat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_cat = Gtk.Label(label="Categoría:", xalign=0)
        lbl_cat.get_style_context().add_class("form-label")
        entry_cat = Gtk.ComboBoxText()
        for c in ["Personalizado", "Lanzador", "Aplicaciones", "Scripts", "Ventanas", "Audio"]:
            entry_cat.append_text(c)
        entry_cat.set_active(0)
        cat_box.pack_start(lbl_cat, False, False, 0)
        cat_box.pack_start(entry_cat, False, False, 0)
        grid.attach(cat_box, 1, 1, 1, 1)

        grid.set_hexpand(True)
        keys_box.set_hexpand(True)
        desc_box.set_hexpand(True)
        cmd_box.set_hexpand(True)
        cat_box.set_hexpand(True)
        add_card.pack_start(grid, False, False, 0)

        # Action buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.END)

        btn_cancel = Gtk.Button(label="󰅖 Cancelar")
        btn_cancel.get_style_context().add_class("cyber-btn-magenta")
        btn_cancel.connect("clicked", lambda b: revealer.set_reveal_child(False))

        btn_save = Gtk.Button(label="󰄬 Guardar y Activar Atajo")
        btn_save.get_style_context().add_class("cyber-btn")

        btn_box.pack_start(btn_cancel, False, False, 0)
        btn_box.pack_start(btn_save, False, False, 0)
        add_card.pack_start(btn_box, False, False, 0)

        revealer.add(add_card)
        page_box.pack_start(revealer, False, False, 0)

        btn_add.connect("clicked", lambda b: revealer.set_reveal_child(not revealer.get_reveal_child()))

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        list_box = Gtk.ListBox()
        list_box.set_selection_mode(Gtk.SelectionMode.NONE)
        list_box.get_style_context().add_class("keybind-list")

        self.keybind_rows = []

        def add_keybind_row(cat, keys, desc, cmd=None, is_custom=False, kb_id=None, prepend=False):
            row = Gtk.ListBoxRow()
            row.get_style_context().add_class("keybind-row")
            r_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            r_box.set_margin_top(6)
            r_box.set_margin_bottom(6)
            r_box.set_margin_start(4)
            r_box.set_margin_end(4)

            cat_lbl = Gtk.Label(label=cat, xalign=0)
            cat_lbl.get_style_context().add_class("category-tag")
            cat_lbl.set_size_request(85, -1)

            key_lbl = Gtk.Label(label=keys, xalign=0)
            key_lbl.get_style_context().add_class("key-badge")
            key_lbl.set_size_request(220, -1)

            full_desc = desc + (f"  →  {cmd}" if (cmd and cmd != desc) else "")
            desc_lbl = Gtk.Label(label=full_desc, xalign=0)
            desc_lbl.get_style_context().add_class("key-desc")

            r_box.pack_start(cat_lbl, False, False, 0)
            r_box.pack_start(key_lbl, False, False, 0)
            r_box.pack_start(desc_lbl, True, True, 0)

            if is_custom:
                badge = Gtk.Label(label="CUSTOM")
                badge.get_style_context().add_class("custom-badge")
                r_box.pack_start(badge, False, False, 0)

                del_btn = Gtk.Button(label="󰅖 Eliminar")
                del_btn.get_style_context().add_class("del-btn")
                del_btn.set_tooltip_text(f"Eliminar atajo {keys}")
                def on_del(b, kid=kb_id, r=row, k_str=keys):
                    self.delete_custom_keybind(kid, k_str)
                    list_box.remove(r)
                    self.keybind_rows = [(rw, txt) for rw, txt in self.keybind_rows if rw != r]
                del_btn.connect("clicked", on_del)
                r_box.pack_start(del_btn, False, False, 0)

            row.add(r_box)
            row.show_all()
            if prepend:
                list_box.prepend(row)
            else:
                list_box.add(row)

            search_text = f"{cat.lower()} {keys.lower()} {desc.lower()} {cmd.lower() if cmd else ''}"
            if prepend:
                self.keybind_rows.insert(0, (row, search_text))
            else:
                self.keybind_rows.append((row, search_text))
            return row

        def on_save_clicked(b):
            raw_keys = entry_keys.get_text().strip()
            raw_desc = entry_desc.get_text().strip()
            raw_cmd = entry_cmd.get_text().strip()
            raw_cat = entry_cat.get_active_text() or "Personalizado"

            if not raw_keys:
                spawn_cmd("notify-send -a 'Cyber Control' -u critical 'Atajo incompleto' 'Debes especificar una combinación de teclas'")
                return
            if not raw_cmd:
                spawn_cmd("notify-send -a 'Cyber Control' -u critical 'Atajo incompleto' 'Debes especificar el comando a ejecutar'")
                return

            if not raw_desc:
                raw_desc = raw_cmd

            kb_id = f"custom_{int(time.time())}"
            new_item = {
                "id": kb_id,
                "cat": raw_cat,
                "keys": raw_keys,
                "desc": raw_desc,
                "cmd": raw_cmd
            }

            custom_list = load_custom_keybinds()
            custom_list.append(new_item)
            save_custom_keybinds(custom_list)

            # Add to list_box at the top
            add_keybind_row(raw_cat, raw_keys, raw_desc, cmd=raw_cmd, is_custom=True, kb_id=kb_id, prepend=True)

            # Reset form & close
            entry_keys.set_text("")
            entry_desc.set_text("")
            entry_cmd.set_text("")
            revealer.set_reveal_child(False)

            spawn_cmd(f"notify-send -a 'Cyber Control' '󰄬 Atajo guardado' '{raw_keys} 󰁔 {raw_desc}'")

        btn_save.connect("clicked", on_save_clicked)

        # 1. Load user custom keybinds first
        custom_kbs = load_custom_keybinds()
        for kb in custom_kbs:
            add_keybind_row(
                kb.get("cat", "Personalizado"),
                kb.get("keys", ""),
                kb.get("desc", ""),
                cmd=kb.get("cmd", ""),
                is_custom=True,
                kb_id=kb.get("id")
            )

        # 2. System default keybinds
        default_keybinds = [
            ("Lanzador", "Super + A", "Caja de aplicaciones (Rofi)"),
            ("Lanzador", "Super + Enter / Super + T", "Terminal Kitty"),
            ("Lanzador", "Super + E", "Gestor de archivos (Dolphin)"),
            ("Lanzador", "Super + S", "Gestor de archivos terminal (Yazi)"),
            ("Lanzador", "Super + B", "Navegador Web (Brave / Firefox)"),
            ("Lanzador", "Super + C", "Editor de código (VS Code)"),
            ("Lanzador", "Super + V", "Historial de Portapapeles (Cliphist)"),
            ("Lanzador", "Super + W", "Selector Wallpaper Engine (Live)"),
            ("Lanzador", "Super + Shift + W", "Selector Fondos Estáticos"),
            ("Lanzador", "Super + , / Super + S", "Panel de Control y Configuración"),
            ("Lanzador", "Super + /", "Cheatsheet de atajos de teclado (<)"),
            ("Ventanas", "Super + Q", "Cerrar ventana activa"),
            ("Ventanas", "Super + F", "Alternar pantalla completa"),
            ("Ventanas", "Super + Shift + F", "Alternar ventana flotante"),
            ("Ventanas", "Super + Espacio", "Centrar ventana activa"),
            ("Ventanas", "Super + J", "Alternar orientación split (Dwindle)"),
            ("Ventanas", "Super + Flechas", "Mover foco de ventana"),
            ("Ventanas", "Super + Shift + Flechas", "Mover ventana de posición"),
            ("Ventanas", "Super + Ctrl + Flechas", "Redimensionar ventana"),
            ("Workspaces", "Super + 1..10", "Cambiar al espacio de trabajo 1..10"),
            ("Workspaces", "Super + Shift + 1..10", "Mover ventana al espacio 1..10"),
            ("Workspaces", "Super + Tab", "Alternar con espacio de trabajo anterior"),
            ("Sistema", "Super + N", "Centro de Control & Notificaciones (SwayNC)"),
            ("Sistema", "Super + Escape", "Menú de energía y apagado (Wlogout)"),
            ("Sistema", "Super + L", "Bloquear pantalla (Hyprlock)"),
            ("Sistema", "Super + Shift + S", "Captura de pantalla de área (Swappy)"),
            ("Sistema", "Print", "Captura de pantalla completa al portapapeles"),
            ("Audio", "Volumen / Brillo", "Teclas multimedia del teclado (OSD)"),
        ]

        for cat, keys, desc in default_keybinds:
            add_keybind_row(cat, keys, desc, is_custom=False)

        def filter_keybinds(entry):
            query = entry.get_text().lower().strip()
            for row, text in self.keybind_rows:
                row.set_visible(query in text if query else True)

        search_entry.connect("search-changed", filter_keybinds)
        scroll.add(list_box)
        page_box.pack_start(scroll, True, True, 0)
        return page_box

    def build_tools_page(self):
        scroll = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.get_style_context().add_class("content-page")

        # 1. Herramientas Rápidas
        c1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        c1.get_style_context().add_class("card")
        c1_title = Gtk.Label(label="🛠 Utilidades Rápidas de Escritorio", xalign=0)
        c1_title.get_style_context().add_class("card-title")
        c1.pack_start(c1_title, False, False, 0)

        grid1 = Gtk.Grid()
        grid1.set_column_spacing(10)
        grid1.set_row_spacing(10)
        grid1.set_column_homogeneous(True)

        b_color = Gtk.Button(label="󰈊 Selector de Color")
        b_color.get_style_context().add_class("cyber-btn")
        b_color.connect("clicked", lambda w: (spawn_cmd("hyprpicker | wl-copy"), self.close_window()))

        b_crop = Gtk.Button(label="󰄀 Captura de Área (Swappy)")
        b_crop.get_style_context().add_class("cyber-btn")
        b_crop.connect("clicked", lambda w: (spawn_cmd("grim -g \"$(slurp)\" - | swappy -f -"), self.close_window()))

        b_full = Gtk.Button(label="󰹑 Captura Pantalla Completa")
        b_full.get_style_context().add_class("cyber-btn")
        b_full.connect("clicked", lambda w: (spawn_cmd("grimblast --notify copysave screen"), self.close_window()))

        b_clip = Gtk.Button(label="󰅇 Portapapeles (Cliphist)")
        b_clip.get_style_context().add_class("cyber-btn")
        b_clip.connect("clicked", lambda w: (spawn_cmd("~/.local/bin/rofi-clipboard"), self.close_window()))

        grid1.attach(b_color, 0, 0, 1, 1)
        grid1.attach(b_crop, 1, 0, 1, 1)
        grid1.attach(b_full, 0, 1, 1, 1)
        grid1.attach(b_clip, 1, 1, 1, 1)
        c1.pack_start(grid1, False, False, 4)
        box.pack_start(c1, False, False, 0)

        # 2. Control de Sesión y Servicios
        c2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        c2.get_style_context().add_class("card")
        c2_title = Gtk.Label(label="󰐥 Control de Sesión y Recarga", xalign=0)
        c2_title.get_style_context().add_class("card-title")
        c2.pack_start(c2_title, False, False, 0)

        grid2 = Gtk.Grid()
        grid2.set_column_spacing(10)
        grid2.set_row_spacing(10)
        grid2.set_column_homogeneous(True)

        b_hypr_reload = Gtk.Button(label="󰑓 Recargar Hyprland")
        b_hypr_reload.get_style_context().add_class("cyber-btn")
        b_hypr_reload.connect("clicked", lambda w: spawn_cmd("hyprctl reload && notify-send 'Hyprland' 'Configuración recargada'"))

        b_wb_reload = Gtk.Button(label="󰑓 Reiniciar Waybar")
        b_wb_reload.get_style_context().add_class("cyber-btn")
        b_wb_reload.connect("clicked", lambda w: spawn_cmd("killall -SIGUSR2 waybar || ~/.local/bin/waybar"))

        b_lock = Gtk.Button(label="󰌾 Bloquear Pantalla")
        b_lock.get_style_context().add_class("cyber-btn-magenta")
        b_lock.connect("clicked", lambda w: (spawn_cmd("~/.local/bin/hypr-lock"), self.close_window()))

        b_power = Gtk.Button(label="⏻ Menú de Sesión")
        b_power.get_style_context().add_class("cyber-btn-magenta")
        b_power.connect("clicked", lambda w: (spawn_cmd("~/.local/bin/hypr-power-menu"), self.close_window()))

        grid2.attach(b_hypr_reload, 0, 0, 1, 1)
        grid2.attach(b_wb_reload, 1, 0, 1, 1)
        grid2.attach(b_lock, 0, 1, 1, 1)
        grid2.attach(b_power, 1, 1, 1, 1)
        c2.pack_start(grid2, False, False, 4)
        box.pack_start(c2, False, False, 0)

        scroll.add(box)
        return scroll

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close_window()
            return True
        return False

    def close_window(self):
        self.destroy()

    def on_destroy(self, widget):
        if os.path.exists(LOCK_FILE):
            try:
                os.remove(LOCK_FILE)
            except Exception:
                pass
        Gtk.main_quit()

if __name__ == "__main__":
    win = CyberSettingsWindow()
    win.show_all()
    Gtk.main()
