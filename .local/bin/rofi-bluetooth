#!/usr/bin/env bash
# rofi-bluetooth: Graphical Bluetooth Menu for Rofi / Waybar

# If blueman-manager is installed, prefer full GUI
if command -v blueman-manager >/dev/null 2>&1; then
    exec blueman-manager
fi

THEME="$HOME/.config/rofi/dialog.rasi"

rofi_cmd() {
    local prompt="${1:-󰂯 Bluetooth}"
    shift || true
    if [[ -f "$THEME" ]]; then
        rofi -dmenu -i -p "$prompt" -theme "$THEME" "$@"
    else
        rofi -dmenu -i -p "$prompt" -theme-str 'window { width: min(760px, 85%); border-radius: 16px; } listview { lines: 8; }' "$@"
    fi
}

# Check status
status=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}')

if [[ "$status" != "yes" ]]; then
    choice=$(echo -e "󰂯  Encender Bluetooth\n󰅖  Cancelar" | rofi_cmd "󰂲 Bluetooth Apagado" -theme-str 'window { width: 500px; } listview { lines: 2; }')
    if [[ "$choice" =~ "Encender" ]]; then
        rfkill unblock bluetooth 2>/dev/null
        bluetoothctl power on
        notify-send -a "Bluetooth" -i "bluetooth" "Bluetooth Activado"
    fi
    exit 0
fi

# Powered ON: Build menu with formatted entries
devices=$(bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
    [[ -z "$mac" ]] && continue
    info=$(bluetoothctl info "$mac" 2>/dev/null)
    if echo "$info" | grep -q "Connected: yes"; then
        echo "󰂱  $name    [Conectado]  :: $mac"
    else
        echo "󰂲  $name  :: $mac"
    fi
done)

menu="󰂲  Apagar Bluetooth\n󰑐  Escanear nuevos dispositivos (5s)\n$devices\n󰅖  Cerrar menú"

chosen=$(echo -e "$menu" | rofi_cmd "󰂯 Dispositivos Bluetooth")

[[ -z "$chosen" || "$chosen" =~ "Cerrar" || "$chosen" =~ "Salir" ]] && exit 0

if [[ "$chosen" =~ "Apagar" ]]; then
    bluetoothctl power off
    notify-send -a "Bluetooth" "Bluetooth Desactivado"
    exit 0
elif [[ "$chosen" =~ "Escanear" ]]; then
    notify-send -a "Bluetooth" -i "bluetooth" "Buscando dispositivos..." "Escaneando durante 5 segundos..."
    bluetoothctl --timeout 5 scan on >/dev/null 2>&1
    exec "$0"
elif [[ "$chosen" =~ "::" ]]; then
    mac=$(echo "$chosen" | awk -F ':: ' '{print $2}' | tr -d ' ')
    name=$(echo "$chosen" | awk -F '::' '{print $1}' | sed 's/^[󰂱󰂲] *//' | sed 's/ *\[Conectado\].*//' | xargs)
    
    if echo "$chosen" | grep -q "\[Conectado\]"; then
        action=$(echo -e "󰌹  Desconectar\n󰆴  Desvincular y Olvidar\n󰅖  Volver" | rofi_cmd "$name" -theme-str 'window { width: 500px; } listview { lines: 3; }')
        case "$action" in
            *"Desconectar"*)
                bluetoothctl disconnect "$mac"
                notify-send -a "Bluetooth" "Desconectado de $name"
                ;;
            *"Desvincular"*)
                bluetoothctl remove "$mac"
                notify-send -a "Bluetooth" "Dispositivo eliminado: $name"
                ;;
        esac
    else
        notify-send -a "Bluetooth" "Conectando a $name..."
        bluetoothctl connect "$mac" && notify-send -a "Bluetooth" "Conectado a $name con éxito" || notify-send -u critical -a "Bluetooth" "Error al conectar a $name"
    fi
fi
