#!/usr/bin/env python3
"""
rofi-wifi: Graphical Wi-Fi Menu for Rofi / Waybar
Designed for Cyber-Anime dotfiles with full nmcli integration and dialog.rasi styling.
"""

import os
import sys
import subprocess

THEME = os.path.expanduser("~/.config/rofi/dialog.rasi")

def notify(title, message, urgency="normal", icon="network-wireless"):
    cmd = ["notify-send", "-a", "Wi-Fi", "-u", urgency]
    if icon:
        cmd += ["-i", icon]
    cmd += [title, message]
    subprocess.run(cmd, check=False)

def rofi_cmd(prompt, items, extra_args=None):
    cmd = ["rofi", "-dmenu", "-i", "-p", prompt]
    if os.path.isfile(THEME):
        cmd += ["-theme", THEME]
    else:
        cmd += ["-theme-str", "window { width: min(760px, 85%); border-radius: 16px; } listview { lines: 8; }"]
    if extra_args:
        cmd += extra_args
    
    input_str = "\n".join(items)
    res = subprocess.run(cmd, input=input_str, text=True, capture_output=True)
    if res.returncode != 0:
        return None
    return res.stdout.strip()

def get_wifi_status():
    res = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True)
    return res.stdout.strip() == "enabled"

def get_saved_connections():
    res = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], capture_output=True, text=True)
    saved = set()
    for line in res.stdout.strip().splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "802-11-wireless":
            saved.add(parts[0])
    return saved

def get_wifi_interface():
    res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], capture_output=True, text=True)
    for line in res.stdout.strip().splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "wifi":
            return parts[0]
    return "wlp4s0"

def get_wifi_networks():
    res = subprocess.run(["nmcli", "-t", "-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list"], capture_output=True, text=True)
    networks = {}
    active_ssid = None

    for line in res.stdout.strip().splitlines():
        if not line:
            continue
        parts = line.split(":")
        if len(parts) < 4:
            continue
        in_use = parts[0].strip()
        try:
            signal = int(parts[1].strip())
        except ValueError:
            signal = 0
        security = parts[2].strip() or "Abierta"
        ssid = ":".join(parts[3:]).strip()
        if not ssid or ssid == "--":
            continue

        if in_use == "*":
            active_ssid = ssid
            networks[ssid] = {"signal": signal, "security": security, "connected": True}
        elif ssid not in networks:
            networks[ssid] = {"signal": signal, "security": security, "connected": False}
        else:
            if not networks[ssid]["connected"] and signal > networks[ssid]["signal"]:
                networks[ssid]["signal"] = signal
                networks[ssid]["security"] = security

    return active_ssid, networks

def get_signal_icon(signal):
    if signal >= 75:
        return "󰤨"
    elif signal >= 50:
        return "󰤥"
    elif signal >= 25:
        return "󰤢"
    return "󰤟"

def show_network_details(ssid, iface):
    res = subprocess.run(["nmcli", "-t", "-f", "IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,GENERAL.HWADDR", "device", "show", iface], capture_output=True, text=True)
    details = {}
    for line in res.stdout.strip().splitlines():
        parts = line.split(":", 1)
        if len(parts) == 2:
            key, val = parts[0].strip(), parts[1].strip()
            if val:
                details[key] = val

    ip = details.get("IP4.ADDRESS[1]", details.get("IP4.ADDRESS", "Desconocida"))
    gw = details.get("IP4.GATEWAY", "Desconocida")
    dns = details.get("IP4.DNS[1]", details.get("IP4.DNS", "Desconocido"))
    mac = details.get("GENERAL.HWADDR", "Desconocida")

    info_lines = [
        f"󰩠  Red (SSID):     {ssid}",
        f"󰈀  IP Local:       {ip}",
        f"󰌘  Puerta Enlace:  {gw}",
        f"󰒘  Servidor DNS:   {dns}",
        f"󰇚  MAC Adapter:    {mac}",
        "󰅖  Volver al menú principal"
    ]
    rofi_cmd(f"󰛳 Detalles: {ssid}", info_lines, ["-theme-str", "window { width: 620px; } listview { lines: 6; }"])

def main():
    if not get_wifi_status():
        choice = rofi_cmd(
            "󰤮 Wi-Fi Desactivado",
            ["󰤨  Encender Wi-Fi", "󰅖  Cancelar"],
            ["-theme-str", "window { width: 500px; } listview { lines: 2; }"]
        )
        if choice and "Encender" in choice:
            subprocess.run(["nmcli", "radio", "wifi", "on"], check=False)
            notify("Wi-Fi Activado", "La interfaz inalámbrica está lista.", icon="network-wireless")
        sys.exit(0)

    saved_ssids = get_saved_connections()
    iface = get_wifi_interface()
    active_ssid, networks = get_wifi_networks()

    menu_items = []
    lookup = {}

    # 1. Active connected network first
    if active_ssid:
        info = networks.get(active_ssid, {"signal": 100, "security": "WPA2"})
        label = f"󰤨  {active_ssid:<20}  [Conectado]  • {info['signal']}% ({info['security']})"
        menu_items.append(label)
        lookup[label] = (active_ssid, True, True, info["security"])

    # 2. Saved networks in range next
    sorted_nets = sorted(networks.items(), key=lambda x: x[1]["signal"], reverse=True)
    for ssid, info in sorted_nets:
        if ssid == active_ssid:
            continue
        if ssid in saved_ssids:
            icon = get_signal_icon(info["signal"])
            label = f"{icon}  {ssid:<20}  [Guardada]   • {info['signal']}% ({info['security']})"
            menu_items.append(label)
            lookup[label] = (ssid, False, True, info["security"])

    # 3. Other available networks
    for ssid, info in sorted_nets:
        if ssid == active_ssid or ssid in saved_ssids:
            continue
        icon = get_signal_icon(info["signal"])
        label = f"{icon}  {ssid:<20}               • {info['signal']}% ({info['security']})"
        menu_items.append(label)
        lookup[label] = (ssid, False, False, info["security"])

    # Footer actions
    menu_items.append("󰑐  Escanear redes (Actualizar lista)")
    menu_items.append("󰤮  Desactivar Wi-Fi")
    menu_items.append("󰅖  Cerrar menú")

    chosen = rofi_cmd("󰤨 Redes Wi-Fi", menu_items)
    if not chosen or "Cerrar" in chosen:
        sys.exit(0)

    if "Escanear redes" in chosen:
        notify("Buscando redes...", "Actualizando la lista de puntos de acceso...", icon="network-wireless")
        subprocess.run(["nmcli", "dev", "wifi", "rescan"], check=False)
        os.execv(sys.argv[0], sys.argv)

    if "Desactivar Wi-Fi" in chosen:
        subprocess.run(["nmcli", "radio", "wifi", "off"], check=False)
        notify("Wi-Fi Desactivado", "Se ha apagado la antena inalámbrica.", icon="network-wireless-offline")
        sys.exit(0)

    if chosen in lookup:
        ssid, is_active, is_saved, security = lookup[chosen]

        if is_active:
            action = rofi_cmd(
                f"󰤨 {ssid}",
                [
                    "󰌹  Desconectar de esta red",
                    "󰛳  Información detallada de conexión",
                    "󰆴  Olvidar esta red",
                    "󰅖  Volver"
                ],
                ["-theme-str", "window { width: 560px; } listview { lines: 4; }"]
            )
            if not action or "Volver" in action:
                os.execv(sys.argv[0], sys.argv)
            elif "Desconectar" in action:
                subprocess.run(["nmcli", "device", "disconnect", iface], check=False)
                notify("Desconectado", f"Te has desconectado de {ssid}", icon="network-wireless-disconnected")
            elif "Detalles" in action:
                show_network_details(ssid, iface)
                os.execv(sys.argv[0], sys.argv)
            elif "Olvidar" in action:
                subprocess.run(["nmcli", "connection", "delete", "id", ssid], check=False)
                notify("Red olvidada", f"Se ha eliminado el perfil de {ssid}", icon="network-wireless")
            sys.exit(0)

        elif is_saved:
            notify("Conectando...", f"Estableciendo enlace con {ssid}...", icon="network-wireless")
            res = subprocess.run(["nmcli", "connection", "up", "id", ssid], capture_output=True, text=True)
            if res.returncode == 0:
                notify("Conectado con éxito", f"Enlazado a {ssid}", icon="network-wireless")
            else:
                notify("Error de conexión", f"No se pudo conectar a {ssid}:\n{res.stderr.strip()}", urgency="critical")
            sys.exit(0)

        else:
            # New unsaved network
            is_open = ("Abierta" in security or "--" in security or not security)
            if is_open:
                notify("Conectando...", f"Enlazando a red abierta {ssid}...", icon="network-wireless")
                res = subprocess.run(["nmcli", "device", "wifi", "connect", ssid], capture_output=True, text=True)
                if res.returncode == 0:
                    notify("Conectado con éxito", f"Enlazado a {ssid}", icon="network-wireless")
                else:
                    notify("Error de conexión", f"No se pudo conectar a {ssid}", urgency="critical")
            else:
                cmd_pass = [
                    "rofi", "-dmenu", "-password", "-p", f"󰌾 Contraseña para {ssid}"
                ]
                if os.path.isfile(THEME):
                    cmd_pass += ["-theme", THEME]
                cmd_pass += ["-theme-str", "window { width: 560px; } listview { lines: 0; }"]
                
                pass_res = subprocess.run(cmd_pass, text=True, capture_output=True)
                password = pass_res.stdout.strip()
                if not password:
                    sys.exit(0)

                notify("Conectando...", f"Verificando credenciales con {ssid}...", icon="network-wireless")
                res = subprocess.run(
                    ["nmcli", "device", "wifi", "connect", ssid, "password", password],
                    capture_output=True, text=True
                )
                if res.returncode == 0:
                    notify("Conectado con éxito", f"Enlazado a {ssid}", icon="network-wireless")
                else:
                    notify("Error de conexión", f"Credenciales inválidas o fallo de conexión a {ssid}", urgency="critical")
            sys.exit(0)

if __name__ == "__main__":
    main()
