#!/usr/bin/env bash
# rofi-launcher — Cyber-Anime App Drawer & Launcher wrapper.
# Opens the unified Rofi app drawer (matching size & aesthetics with wallpaper picker)

export PATH="$HOME/.local/bin:$PATH"

CURRENT_PNG="$HOME/.config/rofi/.current_wallpaper.png"
CURRENT_LINK="$HOME/.config/rofi/.current_wallpaper"

# If symlinks do not exist yet, initialize with fallback
if [[ ! -f "$CURRENT_PNG" && ! -f "$CURRENT_LINK" ]]; then
    WALL_DIR=$(cat "$HOME/.config/rofi/.wall_dir" 2>/dev/null || echo "$HOME/.config/assets/backgrounds/whitehat")
    fallback=$(find "$WALL_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) 2>/dev/null | head -n1)
    if [[ -n "$fallback" ]]; then
        ln -sf "$fallback" "$CURRENT_PNG"
        ln -sf "$fallback" "$CURRENT_LINK"
    fi
fi

# Launch rofi with launcher theme
if [[ $# -eq 0 ]]; then
    exec rofi -show drun -theme "$HOME/.config/rofi/launcher.rasi"
else
    exec rofi -theme "$HOME/.config/rofi/launcher.rasi" "$@"
fi
