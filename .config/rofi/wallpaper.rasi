/* wallpaper.rasi — galleria picker per rofi-wallpaper.
 * Layout: 6 colonne × 2 righe, thumbnail orizzontali.
 * Non importa launcher.rasi: usa solo colors.rasi per la palette.
 */

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
}

/* ---- Window ---- */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            92%;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    @border-r;
    padding:          0.8em;
}

/* ---- Mainbox ---- */
mainbox {
    children:         [ "inputbar", "listview" ];
    spacing:          0.6em;
    background-color: transparent;
}

/* ---- Search bar ---- */
inputbar {
    children:         [ "prompt", "entry" ];
    spacing:          0.5em;
    padding:          0.5em 0.8em;
    background-color: @bg-alt;
    border-radius:    @border-r-inner;
}

prompt {
    text-color:       @accent;
}

entry {
    placeholder:       "🖼️  Cerca wallpaper…";
    placeholder-color: @fg-dim;
    text-color:        @fg;
    cursor:            text;
}

/* ---- Galleria thumbnail ---- */
listview {
    columns:          6;
    lines:            2;
    flow:             horizontal;
    fixed-width:      true;
    fixed-height:     false;
    spacing:          10px;
    padding:          6px;
    cycle:            true;
    scrollbar:        false;
    dynamic:          true;
    background-color: transparent;
}

/* ---- Singola voce (thumbnail sopra, nome sotto) ---- */
element {
    orientation:      vertical;
    padding:          6px;
    border-radius:    @border-r-element;
    background-color: transparent;
    cursor:           pointer;
    spacing:          4px;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border:           2px solid;
    border-color:     @accent;
}

/* Thumbnail: path assoluto passato come icon → rofi lo renderizza come immagine */
element-icon {
    size:             20%;
    background-color: transparent;
    border-radius:    @border-r-element;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    text-color:       @fg-alt;
    font:             "JetBrainsMono Nerd Font 8";
    padding:          2px 0px 0px 0px;
}
