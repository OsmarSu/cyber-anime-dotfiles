/* launcher.rasi — Cyber-Anime App Drawer (Super + A)
 * Layout: 980x620px spacious window, 3.2em prominent icons, 2 columns.
 * Dynamic Wallpaper Engine background integration with high-res 1:1 scaling.
 */

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 13";
}

/* ---- Window ---- */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            980px;
    height:           620px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    @border-r;
    padding:          0px;
}

/* ---- Mainbox: horizontal layout with Wallpaper Engine dynamic background ---- */
mainbox {
    orientation:      horizontal;
    children:         [ "mode-switcher", "listbox" ];
    spacing:          0px;
    padding:          0px;
    border-radius:    @border-r;
    background-image: url("/home/oswi/.config/rofi/.current_wallpaper.png", both);
}

/* ---- Left sidebar: mode switcher ---- */
mode-switcher {
    orientation:      vertical;
    expand:           false;
    width:            76px;
    spacing:          0.8em;
    padding:          1.2em 0.4em;
    background-color: @bg-alt;
    border-radius:    @border-r;
}

button {
    padding:          0.9em 0.3em;
    border-radius:    @border-r-inner;
    background-color: transparent;
    text-color:       @fg-dim;
    cursor:           pointer;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 24";
}

button selected {
    background-color: @bg-selected;
    text-color:       @accent;
}

/* ---- Content Area: Search Bar + App Grid ---- */
listbox {
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
    spacing:          0.8em;
    padding:          1.2em;
    background-color: transparent;
}

/* ---- Search bar ---- */
inputbar {
    children:         [ "prompt", "entry" ];
    spacing:          0.8em;
    padding:          0.7em 1.2em;
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    @border-r-inner;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 14";
}

entry {
    placeholder:        "Buscar aplicaciones...";
    placeholder-color:  @fg-dim;
    text-color:         @fg;
    cursor:             text;
    font:               "JetBrainsMono Nerd Font 13";
}

/* ---- Results: 2 columns with spacious app cards ---- */
listview {
    columns:          2;
    lines:            5;
    spacing:          0.6em;
    cycle:            true;
    scrollbar:        false;
    fixed-height:     true;
    background-color: #08090db8;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    @border-r-inner;
    padding:          0.6em;
}

/* ---- App Card Element ---- */
element {
    padding:          0.8em 1em;
    border-radius:    @border-r-element;
    spacing:          1em;
    children:         [ "element-icon", "element-text" ];
    cursor:           pointer;
    background-color: #0e111a88;
}

element normal.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @accent;
    border:           0px 0px 0px 4px;
    border-color:     @accent;
}

/* ---- Large Prominent App Icons ---- */
element-icon {
    size:             3.2em;
    background-color: transparent;
}

element-text {
    text-color:     inherit;
    font:           "JetBrainsMono Nerd Font SemiBold 13";
    vertical-align: 0.5;
}

element urgent {
    text-color: @urgent;
}
