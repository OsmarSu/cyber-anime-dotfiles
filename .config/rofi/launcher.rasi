/* launcher.rasi — Cyber-Anime App Drawer (Super + A)
 * Spacious 1140x700px window with dynamic wallpaper integration and translucent glass.
 */

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 13";
}

/* ---- Window: 1140x700px Unified Spacious Canvas ---- */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            1140px;
    height:           700px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    18px;
    padding:          0px;
}

/* ---- Mainbox: horizontal layout with Wallpaper dynamic background ---- */
mainbox {
    orientation:      horizontal;
    children:         [ "mode-switcher", "listbox" ];
    spacing:          0px;
    padding:          0px;
    border-radius:    18px;
    background-image: url("/home/oswi/.config/rofi/.current_wallpaper.png", both);
}

/* ---- Left sidebar: mode switcher ---- */
mode-switcher {
    orientation:      vertical;
    expand:           false;
    width:            82px;
    spacing:          1em;
    padding:          1.5em 0.5em;
    background-color: rgba(10, 13, 20, 0.88);
    border-radius:    18px 0px 0px 18px;
}

button {
    padding:          1em 0.4em;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @fg-dim;
    cursor:           pointer;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 24";
}

button selected {
    background-color: @bg-selected;
    text-color:       @accent;
    border:           0px 0px 0px 3px;
    border-color:     @accent;
}

/* ---- Content Area: Search Bar + App Grid ---- */
listbox {
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
    spacing:          1em;
    padding:          1.4em;
    background-color: rgba(8, 9, 13, 0.45);
}

/* ---- Search bar ---- */
inputbar {
    children:         [ "prompt", "entry" ];
    spacing:          0.8em;
    padding:          0.8em 1.2em;
    background-color: rgba(14, 17, 26, 0.88);
    border:           1px solid;
    border-color:     @surface;
    border-radius:    12px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 14";
}

entry {
    placeholder:        "Buscar aplicaciones...";
    placeholder-color:  @fg-dim;
    text-color:         @fg;
    cursor:             text;
    font:               "JetBrainsMono Nerd Font 13";
}

/* ---- Results: 2 columns with spacious translucent app cards ---- */
listview {
    columns:          2;
    lines:            6;
    spacing:          0.7em;
    cycle:            true;
    scrollbar:        false;
    fixed-height:     true;
    background-color: rgba(8, 9, 13, 0.68);
    border:           1px solid;
    border-color:     @surface;
    border-radius:    14px;
    padding:          0.8em;
}

/* ---- App Card Element ---- */
element {
    padding:          0.8em 1em;
    border-radius:    10px;
    spacing:          1em;
    children:         [ "element-icon", "element-text" ];
    cursor:           pointer;
    background-color: rgba(14, 17, 26, 0.60);
}

element normal.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @accent;
    border:           0px 0px 0px 4px;
    border-color:     @accent;
}

/* ---- Large Prominent App Icons ---- */
element-icon {
    size:             3.2em;
    background-color: transparent;
}

element-text {
    text-color:     inherit;
    font:           "JetBrainsMono Nerd Font SemiBold 13";
    vertical-align: 0.5;
}

element urgent {
    text-color: @urgent;
}
