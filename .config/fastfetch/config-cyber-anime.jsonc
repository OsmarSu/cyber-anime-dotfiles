{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-icat",
    "source": "/home/oswi/.config/fastfetch/alya_kujou.png",
    "width": 30,
    "height": 15,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": " 󰄾 ",
    "key": {
      "width": 14
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "magenta"
      }
    },
    "separator",

    {
      "type": "custom",
      "format": "\u001b[1;36m╭─────────── CYBER://SYSTEM ───────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "󰞷 Term",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
      "keyColor": "cyan"
    },

    {
      "type": "custom",
      "format": "\u001b[1;35m├─────────── HARDWARE ─────────────────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "󰍹 Screen",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[1;36m╰──────────────────────────────────────╯\u001b[0m"
    },
    "break",
    "colors"
  ]
}
