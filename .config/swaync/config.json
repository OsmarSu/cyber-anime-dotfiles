{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 48,
  "control-center-margin-bottom": 16,
  "control-center-margin-right": 16,
  "control-center-width": 410,
  "control-center-height": 720,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "Sin notificaciones",
  "script-fail-notify": true,
  "notification-visibility": {
    "system-osd": {
      "state": "transient",
      "app-name": "System",
      "summary": "^(Volume|Audio|Brightness|Microphone)$"
    }
  },
  "widgets": [
    "title#header",
    "dnd",
    "buttons-grid",
    "volume",
    "slider#microphone",
    "backlight",
    "title#notifications",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title#header": {
      "text": "Centro de Control & Notificaciones",
      "clear-all-button": false
    },
    "title#notifications": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar todo"
    },
    "dnd": {
      "text": "No Molestar"
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        { "label": "󰤨", "command": "kitty --class floating-tool -e nmtui" },
        { "label": "󰂯", "command": "$HOME/.local/bin/rofi-bluetooth" },
        { "label": "󰕾", "command": "$HOME/.local/bin/volume-popup" },
        { "label": "󰃞", "command": "$HOME/.local/bin/toggle-nightlight" },
        { "label": "󰄀", "command": "sh -c 'if command -v swappy >/dev/null 2>&1; then grim -g \"$(slurp)\" - | swappy -f -; else grimblast --notify copysave area; fi'" },
        { "label": "󰸉", "command": "$HOME/.local/bin/wpe-picker" },
        { "label": "󰒓", "command": "$HOME/.local/bin/cyber-settings" },
        { "label": "󰌾", "command": "$HOME/.local/bin/hypr-lock" }
      ]
    },
    "volume": {
      "label": "󰕿",
      "show-per-app": false
    },
    "slider#microphone": {
      "label": "󰍬",
      "cmd_setter": "pactl set-source-volume @DEFAULT_SOURCE@ $value%",
      "cmd_getter": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print int($2 * 100)}'",
      "min": 0,
      "max": 100,
      "min_limit": 0,
      "max_limit": 100
    },
    "backlight": {
      "label": "󰃞",
      "device": "amdgpu_bl1",
      "subsystem": "backlight",
      "min": 1
    },
    "mpris": {
      "image-size": 84,
      "image-radius": 8
    }
  }
}
