{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 38,
  "spacing": 6,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": [
    "custom/appmenu",
    "hyprland/workspaces",
    "custom/wpe",
    "hyprland/window",
    "mpris"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "custom/idle-inhibitor",
    "group/hardware",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "custom/settings",
    "custom/control-center",
    "custom/power"
  ],

  "custom/appmenu": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Caja de aplicaciones (Super + A)",
    "on-click": "$HOME/.local/bin/rofi-launcher"
  },

  "custom/wpe": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "Wallpaper Engine Picker (Super + W)",
    "on-click": "$HOME/.local/bin/wpe-picker"
  },

  "hyprland/workspaces": {
    "all-outputs": true,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "•",
    "window-rewrite": {
      "class<firefox|zen|brave-browser>": "󰈹",
      "class<kitty|alacritty>": "󰄛",
      "class<discord|vesktop>": "󰙯",
      "class<steam>": "󰓓",
      "class<code|vscodium>": "󰨞",
      "class<dolphin|yazi>": "󰉋",
      "class<obsidian>": "󰎕",
      "class<spotify>": "󰓇"
    },
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{}",
    "icon": true,
    "icon-size": 14,
    "max-length": 30,
    "separate-outputs": true
  },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "max-length": 30,
    "player-icons": {
      "default": "󰐊",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "brave": "󰈹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{player}: {title} — {artist}\nClic: Pausar/Reanudar\nClic der: Siguiente",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "clock": {
    "format": "󱑂 {0:%H:%M}  󰸗 {0:%d %b}",
    "format-alt": "󰸗 {:%d %B %Y}  󱑂 {:%H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "$HOME/.local/bin/calendar-popup",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "months":   "<span color='#00f0ff'><b>{}</b></span>",
        "weekdays": "<span color='#8fa8b8'><b>{}</b></span>",
        "today":    "<span color='#ff007f'><b>{}</b></span>",
        "days":     "<span color='#e2f1f8'>{}</span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/idle-inhibitor": {
    "format": "{}",
    "exec": "pgrep -x hypridle > /dev/null && echo '󰒲' || echo '☕'",
    "on-click": "$HOME/.config/waybar/scripts/idle-toggle.sh",
    "signal": 8,
    "tooltip": true,
    "tooltip-format": "Inhibidor de reposo (☕ despierto · 󰒲 reposo)"
  },

  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "drawer-item",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "disk"
    ]
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "Uso de CPU: {usage}%\nClic: Monitor btop",
    "on-click": "kitty --class floating-tool -e btop"
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB\nClic: Monitor btop",
    "on-click": "kitty --class floating-tool -e btop"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C",
    "tooltip-format": "Temperatura: {temperatureC}°C"
  },

  "disk": {
    "interval": 60,
    "format": "󰋊 {percentage_used}%",
    "tooltip-format": "Disco: {used} de {total} ({percentage_used}%)\nLibre: {free}\nClic: Monitor btop",
    "on-click": "kitty --class floating-tool -e btop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Silenciado",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "$HOME/.local/bin/volume-popup",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} ({volume}%)\nClic izq: Control de volumen\nClic der: Silenciar\nScroll: Subir/Bajar volumen"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Conectado",
    "format-linked": "󰈀 {ifname} (Sin red)",
    "format-disconnected": "󰤭 Desconectado",
    "format-alt": "󰈀 {ipaddr}/{cidr}",
    "tooltip-format": "Red: {ifname}\nIP: {ipaddr}\nPuerta de enlace: {gwaddr}\n\nClic izq: Gestor Wi-Fi (nmtui)\nClic der: Conexiones avanzadas",
    "on-click": "kitty --class floating-tool -e nmtui",
    "on-click-right": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯 {status}",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "format-disabled": "󰂲 Off",
    "tooltip-format": "Bluetooth: {controller_alias}\nDispositivos: {num_connections}\nClic izq: Menú Bluetooth gráfico\nClic der: Alternar encendido",
    "on-click": "$HOME/.local/bin/rofi-bluetooth",
    "on-click-right": "$HOME/.config/hypr/scripts/toggle-bluetooth"
  },

  "battery": {
    "states": { "good": 95, "warning": 30, "critical": 20 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% ({timeTo})\nClic: Monitor de recursos",
    "on-click": "kitty --class floating-tool -e btop"
  },

  "custom/settings": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Panel de Control y Configuración (Super + S)\nClic: Abrir Centro de Ajustes Cyber",
    "on-click": "$HOME/.local/bin/cyber-settings"
  },

  "custom/control-center": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#ff007f'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#ff007f'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#ff007f'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#ff007f'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip": true,
    "tooltip-format": "Centro de Notificaciones\nClic izq: Abrir panel lateral (derecha)\nClic der: Alternar No Molestar"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Menú de apagado y sesión (Super + Esc)",
    "on-click": "hypr-power-menu"
  }
}
