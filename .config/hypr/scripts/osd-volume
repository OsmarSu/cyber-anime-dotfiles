#!/bin/sh

state_dir="${XDG_RUNTIME_DIR:-/tmp}/hypr-osd-notify"
id_file="$state_dir/volume.id"

mkdir -p "$state_dir"

has_wpctl() { command -v wpctl >/dev/null 2>&1; }

case "$1" in
  up)
    if has_wpctl; then
      wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    elif command -v pamixer >/dev/null 2>&1; then
      pamixer -i 5
    fi
    ;;
  down)
    if has_wpctl; then
      wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    elif command -v pamixer >/dev/null 2>&1; then
      pamixer -d 5
    fi
    ;;
  mute)
    if has_wpctl; then
      wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    elif command -v pamixer >/dev/null 2>&1; then
      pamixer -t
    fi
    ;;
  mic)
    id_file="$state_dir/microphone.id"
    if has_wpctl; then
      wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
      out="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || echo 'Volume: 1.00')"
      muted="false"
      echo "$out" | grep -q 'MUTED' && muted="true"
      vol="$(echo "$out" | awk '{print int($2 * 100)}')"
    else
      pamixer --default-source -t 2>/dev/null || true
      muted="$(pamixer --default-source --get-mute 2>/dev/null || echo false)"
      vol="$(pamixer --default-source --get-volume 2>/dev/null || echo 100)"
    fi

    if [ "$muted" = "true" ]; then
      icon="microphone-sensitivity-muted"
      body="Silenciado"
      value=0
    else
      icon="microphone-sensitivity-high"
      body="Activo"
      value="$vol"
    fi
    summary="Micrófono"
    ;;
  *)
    exit 2
    ;;
esac

if [ "$1" != "mic" ]; then
  if has_wpctl; then
    out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo 'Volume: 1.00')"
    muted="false"
    echo "$out" | grep -q 'MUTED' && muted="true"
    volume="$(echo "$out" | awk '{print int($2 * 100)}')"
  else
    muted="$(pamixer --get-mute 2>/dev/null || echo false)"
    volume="$(pamixer --get-volume 2>/dev/null || echo 100)"
  fi
  summary="Volumen"

  if [ "$muted" = "true" ]; then
    icon="audio-volume-muted"
    body="Silenciado"
    value=0
  else
    body="${volume}%"
    value="$volume"
    if [ "$volume" -le 33 ]; then
      icon="audio-volume-low"
    elif [ "$volume" -le 66 ]; then
      icon="audio-volume-medium"
    else
      icon="audio-volume-high"
    fi
  fi
fi

old_id=""
[ -s "$id_file" ] && old_id="$(cat "$id_file")"

if [ -n "$old_id" ]; then
  new_id="$(notify-send -p -e -a "System" -r "$old_id" -i "$icon" \
    -h "string:synchronous:system-${summary}" \
    -h "int:value:${value}" \
    -t 1200 "$summary" "$body")"
else
  new_id="$(notify-send -p -e -a "System" -i "$icon" \
    -h "string:synchronous:system-${summary}" \
    -h "int:value:${value}" \
    -t 1200 "$summary" "$body")"
fi

[ -n "$new_id" ] && printf '%s\n' "$new_id" > "$id_file"
